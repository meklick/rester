[
  {
    "id": "001",
    "body": "城址の\n石に腰掛け\n禁制の木の実をひとり味ひしこと",
    "author": "石川啄木",
    "year": 1910,
    "genre": "短歌",
    "source": "一握の砂",
    "source_record_id": "aozora-000153-816-165",
    "source_url": "https://www.aozora.gr.jp/cards/000153/card816.html"
  },
  {
    "id": "002",
    "body": "夷かに麦の青める\n丘の根の\n小径に赤き小櫛ひろへり",
    "author": "石川啄木",
    "year": 1910,
    "genre": "短歌",
    "source": "一握の砂",
    "source_record_id": "aozora-000153-816-484",
    "source_url": "https://www.aozora.gr.jp/cards/000153/card816.html"
  },
  {
    "id": "003",
    "body": "ひさしぶりに公園に来て\n友に会ひ\n堅く手握り口疾に語る",
    "author": "石川啄木",
    "year": 1910,
    "genre": "短歌",
    "source": "一握の砂",
    "source_record_id": "aozora-000153-816-533",
    "source_url": "https://www.aozora.gr.jp/cards/000153/card816.html"
  },
  {
    "id": "004",
    "body": "うす紅く雪に流れて\n入日影\n曠野の汽車の窓を照せり",
    "author": "石川啄木",
    "year": 1910,
    "genre": "短歌",
    "source": "一握の砂",
    "source_record_id": "aozora-000153-816-368",
    "source_url": "https://www.aozora.gr.jp/cards/000153/card816.html"
  },
  {
    "id": "005",
    "body": "糸切れし紙鳶のごとくに\n若き日の心かろくも\nとびさりしかな",
    "author": "石川啄木",
    "year": 1910,
    "genre": "短歌",
    "source": "一握の砂",
    "source_record_id": "aozora-000153-816-198",
    "source_url": "https://www.aozora.gr.jp/cards/000153/card816.html"
  },
  {
    "id": "006",
    "body": "夜おそく戸を繰りをれば\n白きもの庭を走れり\n犬にやあらむ",
    "author": "石川啄木",
    "year": 1910,
    "genre": "短歌",
    "source": "一握の砂",
    "source_record_id": "aozora-000153-816-515",
    "source_url": "https://www.aozora.gr.jp/cards/000153/card816.html"
  },
  {
    "id": "007",
    "body": "旅の子の\nふるさとに来て眠るがに\nげに静かにも冬の来しかな",
    "author": "石川啄木",
    "year": 1910,
    "genre": "短歌",
    "source": "一握の砂",
    "source_record_id": "aozora-000153-816-303",
    "source_url": "https://www.aozora.gr.jp/cards/000153/card816.html"
  },
  {
    "id": "008",
    "body": "死にたくはないかと言へば\nこれ見よと\n咽喉の痍を見せし女かな",
    "author": "石川啄木",
    "year": 1910,
    "genre": "短歌",
    "source": "一握の砂",
    "source_record_id": "aozora-000153-816-393",
    "source_url": "https://www.aozora.gr.jp/cards/000153/card816.html"
  },
  {
    "id": "009",
    "body": "鏡とり\n能ふかぎりのさまざまの顔をしてみぬ\n泣き飽きし時",
    "author": "石川啄木",
    "year": 1910,
    "genre": "短歌",
    "source": "一握の砂",
    "source_record_id": "aozora-000153-816-024",
    "source_url": "https://www.aozora.gr.jp/cards/000153/card816.html"
  },
  {
    "id": "010",
    "body": "神寂びし七山の杉\n火のごとく染めて日入りぬ\n静かなるかな",
    "author": "石川啄木",
    "year": 1910,
    "genre": "短歌",
    "source": "一握の砂",
    "source_record_id": "aozora-000153-816-257",
    "source_url": "https://www.aozora.gr.jp/cards/000153/card816.html"
  },
  {
    "id": "011",
    "body": "一度でも我に頭を下げさせし\n人みな死ねと\nいのりてしこと",
    "author": "石川啄木",
    "year": 1910,
    "genre": "短歌",
    "source": "一握の砂",
    "source_record_id": "aozora-000153-816-094",
    "source_url": "https://www.aozora.gr.jp/cards/000153/card816.html"
  },
  {
    "id": "012",
    "body": "はたはたと黍の葉鳴れる\nふるさとの軒端なつかし\n秋風吹けば",
    "author": "石川啄木",
    "year": 1910,
    "genre": "短歌",
    "source": "一握の砂",
    "source_record_id": "aozora-000153-816-270",
    "source_url": "https://www.aozora.gr.jp/cards/000153/card816.html"
  },
  {
    "id": "013",
    "body": "ふるさとの停車場路の\n川ばたの\n胡桃の下に小石拾へり",
    "author": "石川啄木",
    "year": 1910,
    "genre": "短歌",
    "source": "一握の砂",
    "source_record_id": "aozora-000153-816-251",
    "source_url": "https://www.aozora.gr.jp/cards/000153/card816.html"
  },
  {
    "id": "014",
    "body": "つくづくと手をながめつつ\nおもひ出でぬ\nキスが上手の女なりしが",
    "author": "石川啄木",
    "year": 1910,
    "genre": "短歌",
    "source": "一握の砂",
    "source_record_id": "aozora-000153-816-441",
    "source_url": "https://www.aozora.gr.jp/cards/000153/card816.html"
  },
  {
    "id": "015",
    "body": "遠くより笛の音きこゆ\nうなだれてある故やらむ\nなみだ流るる",
    "author": "石川啄木",
    "year": 1910,
    "genre": "短歌",
    "source": "一握の砂",
    "source_record_id": "aozora-000153-816-057",
    "source_url": "https://www.aozora.gr.jp/cards/000153/card816.html"
  },
  {
    "id": "016",
    "body": "ほとばしる喞筒の水の\n心地よさよ\nしばしは若きこころもて見る",
    "author": "石川啄木",
    "year": 1910,
    "genre": "短歌",
    "source": "一握の砂",
    "source_record_id": "aozora-000153-816-156",
    "source_url": "https://www.aozora.gr.jp/cards/000153/card816.html"
  },
  {
    "id": "017",
    "body": "事もなく\n且つこころよく肥えてゆく\nわがこのごろの物足らぬかな",
    "author": "石川啄木",
    "year": 1910,
    "genre": "短歌",
    "source": "一握の砂",
    "source_record_id": "aozora-000153-816-105",
    "source_url": "https://www.aozora.gr.jp/cards/000153/card816.html"
  },
  {
    "id": "018",
    "body": "亡くなれる師がその昔\nたまひたる\n地理の本など取りいでて見る",
    "author": "石川啄木",
    "year": 1910,
    "genre": "短歌",
    "source": "一握の砂",
    "source_record_id": "aozora-000153-816-202",
    "source_url": "https://www.aozora.gr.jp/cards/000153/card816.html"
  },
  {
    "id": "019",
    "body": "かくばかり熱き涙は\n初恋の日にもありきと\n泣く日またなし",
    "author": "石川啄木",
    "year": 1910,
    "genre": "短歌",
    "source": "一握の砂",
    "source_record_id": "aozora-000153-816-286",
    "source_url": "https://www.aozora.gr.jp/cards/000153/card816.html"
  },
  {
    "id": "020",
    "body": "あたらしき木のかをりなど\nただよへる\n新開町の春の静けさ",
    "author": "石川啄木",
    "year": 1910,
    "genre": "短歌",
    "source": "一握の砂",
    "source_record_id": "aozora-000153-816-456",
    "source_url": "https://www.aozora.gr.jp/cards/000153/card816.html"
  },
  {
    "id": "021",
    "body": "手も足も\n室いっぱいに投げ出して\nやがて静かに起きかへるかな",
    "author": "石川啄木",
    "year": 1910,
    "genre": "短歌",
    "source": "一握の砂",
    "source_record_id": "aozora-000153-816-044",
    "source_url": "https://www.aozora.gr.jp/cards/000153/card816.html"
  },
  {
    "id": "022",
    "body": "忘れ来し煙草を思ふ\nゆけどゆけど\n山なほ遠き雪の野の汽車",
    "author": "石川啄木",
    "year": 1910,
    "genre": "短歌",
    "source": "一握の砂",
    "source_record_id": "aozora-000153-816-367",
    "source_url": "https://www.aozora.gr.jp/cards/000153/card816.html"
  },
  {
    "id": "023",
    "body": "売ることを差し止められし\n本の著者に\n路にて会へる秋の朝かな",
    "author": "石川啄木",
    "year": 1910,
    "genre": "短歌",
    "source": "一握の砂",
    "source_record_id": "aozora-000153-816-508",
    "source_url": "https://www.aozora.gr.jp/cards/000153/card816.html"
  },
  {
    "id": "024",
    "body": "そのかみの愛読の書よ\n大方は\n今は流行らずなりにけるかな",
    "author": "石川啄木",
    "year": 1910,
    "genre": "短歌",
    "source": "一握の砂",
    "source_record_id": "aozora-000153-816-175",
    "source_url": "https://www.aozora.gr.jp/cards/000153/card816.html"
  },
  {
    "id": "025",
    "body": "砂山の裾によこたはる流木に\nあたり見まはし\n物言ひてみる",
    "author": "石川啄木",
    "year": 1910,
    "genre": "短歌",
    "source": "一握の砂",
    "source_record_id": "aozora-000153-816-007",
    "source_url": "https://www.aozora.gr.jp/cards/000153/card816.html"
  },
  {
    "id": "026",
    "body": "三度ほど\n汽車の窓よりながめたる町の名なども\nしたしかりけり",
    "author": "石川啄木",
    "year": 1910,
    "genre": "短歌",
    "source": "一握の砂",
    "source_record_id": "aozora-000153-816-306",
    "source_url": "https://www.aozora.gr.jp/cards/000153/card816.html"
  },
  {
    "id": "027",
    "body": "気がつけば\nしっとりと夜霧下りて居り\nながくも街をさまよへるかな",
    "author": "石川啄木",
    "year": 1910,
    "genre": "短歌",
    "source": "一握の砂",
    "source_record_id": "aozora-000153-816-524",
    "source_url": "https://www.aozora.gr.jp/cards/000153/card816.html"
  },
  {
    "id": "028",
    "body": "よく笑ふ若き男の\n死にたらば\nすこしはこの世さびしくもなれ",
    "author": "石川啄木",
    "year": 1910,
    "genre": "短歌",
    "source": "一握の砂",
    "source_record_id": "aozora-000153-816-076",
    "source_url": "https://www.aozora.gr.jp/cards/000153/card816.html"
  },
  {
    "id": "029",
    "body": "君に似し姿を街に見る時の\nこころ躍りを\nあはれと思へ",
    "author": "石川啄木",
    "year": 1910,
    "genre": "短歌",
    "source": "一握の砂",
    "source_record_id": "aozora-000153-816-428",
    "source_url": "https://www.aozora.gr.jp/cards/000153/card816.html"
  },
  {
    "id": "030",
    "body": "何もかも行末の事みゆるごとき\nこのかなしみは\n拭ひあへずも",
    "author": "石川啄木",
    "year": 1910,
    "genre": "短歌",
    "source": "一握の砂",
    "source_record_id": "aozora-000153-816-102",
    "source_url": "https://www.aozora.gr.jp/cards/000153/card816.html"
  },
  {
    "id": "031",
    "body": "ものなべてうらはかなげに\n暮れゆきぬ\nとりあつめたる悲しみの日は",
    "author": "石川啄木",
    "year": 1910,
    "genre": "短歌",
    "source": "一握の砂",
    "source_record_id": "aozora-000153-816-259",
    "source_url": "https://www.aozora.gr.jp/cards/000153/card816.html"
  },
  {
    "id": "032",
    "body": "しらなみの寄せて騒げる\n函館の大森浜に\n思ひしことども",
    "author": "石川啄木",
    "year": 1910,
    "genre": "短歌",
    "source": "一握の砂",
    "source_record_id": "aozora-000153-816-318",
    "source_url": "https://www.aozora.gr.jp/cards/000153/card816.html"
  },
  {
    "id": "033",
    "body": "よく怒る人にてありしわが父の\n日ごろ怒らず\n怒れと思ふ",
    "author": "石川啄木",
    "year": 1910,
    "genre": "短歌",
    "source": "一握の砂",
    "source_record_id": "aozora-000153-816-490",
    "source_url": "https://www.aozora.gr.jp/cards/000153/card816.html"
  },
  {
    "id": "034",
    "body": "伴なりしかの代議士の\n口あける青き寐顔を\nかなしと思ひき",
    "author": "石川啄木",
    "year": 1910,
    "genre": "短歌",
    "source": "一握の砂",
    "source_record_id": "aozora-000153-816-372",
    "source_url": "https://www.aozora.gr.jp/cards/000153/card816.html"
  },
  {
    "id": "035",
    "body": "さらさらと氷の屑が\n波に鳴る\n磯の月夜のゆきかへりかな",
    "author": "石川啄木",
    "year": 1910,
    "genre": "短歌",
    "source": "一握の砂",
    "source_record_id": "aozora-000153-816-403",
    "source_url": "https://www.aozora.gr.jp/cards/000153/card816.html"
  }
]
